{
  "name": "shadcn-loaders",
  "version": "1.0.2",
  "description": "A shadcn-compatible registry package for modern React loaders and loading states. Install with npx shadcn add @shadcnloaders/loader.",
  "author": "Sammed-Chougule",
  "license": "MIT",
  "homepage": "https://github.com/Sammed-Chougule/Shadcn-Loaders",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sammed-Chougule/Shadcn-Loaders.git"
  },
  "bugs": {
    "url": "https://github.com/Sammed-Chougule/Shadcn-Loaders/issues"
  },
  "keywords": [
    "shadcn",
    "loader",
    "react",
    "tailwindcss",
    "spinner"
  ],
  "type": "module",
  "bin": {
    "shadcn-loaders": "bin/shadcn-loaders.js"
  },
  "files": [
    "bin",
    "registry",
    "registry.json",
    "loader.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "shadcn build && vite build",
    "preview": "vite preview",
    "registry:build": "shadcn build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "shadcn": "^4.15.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
